{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and contact information for Pakistani farmers and seed growers",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "whatsapp": { "type": "string", "maxLength": 30 },
        "city": { "type": "string", "maxLength": 100 },
        "province": { "type": "string", "maxLength": 60 },
        "photoUrl": { "type": "string", "maxLength": 2048 },
        "bio": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["farmer", "grower", "admin"] },
        "isSuspended": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "phone", "city", "role"]
    },
    "Seed": {
      "title": "Seed",
      "description": "Desi and traditional seed listing for exchange or sale",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "type": { "type": "string", "enum": ["exchange", "sale"] },
        "category": { "type": "string", "maxLength": 60 },
        "price": { "type": "number" },
        "quantity": { "type": "string", "maxLength": 50 },
        "unit": { "type": "string", "maxLength": 30 },
        "city": { "type": "string", "maxLength": 100 },
        "location": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 2000 },
        "images": { "type": "array" },
        "ownerId": { "type": "string", "maxLength": 128 },
        "ownerName": { "type": "string", "maxLength": 100 },
        "ownerPhone": { "type": "string", "maxLength": 30 },
        "ownerWhatsapp": { "type": "string", "maxLength": 30 },
        "status": { "type": "string", "enum": ["active", "exchanged", "sold", "archived"] },
        "exchangeFor": { "type": "string", "maxLength": 150 },
        "harvestYear": { "type": "string", "maxLength": 20 },
        "germinationRate": { "type": "string", "maxLength": 20 },
        "isOrganic": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "type", "category", "quantity", "city", "ownerId", "status"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Real-time private messaging thread between two farmers regarding seeds",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "participantIds": { "type": "array" },
        "participantNames": { "type": "object" },
        "participantPhones": { "type": "object" },
        "lastMessageText": { "type": "string", "maxLength": 500 },
        "lastMessageTime": { "type": "string", "format": "date-time" },
        "seedId": { "type": "string", "maxLength": 128 },
        "seedTitle": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "participantIds", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Text, voice audio or photo message in a conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "conversationId": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "enum": ["text", "voice", "image"] },
        "text": { "type": "string", "maxLength": 2000 },
        "mediaUrl": { "type": "string", "maxLength": 300000 },
        "durationSeconds": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "conversationId", "senderId", "type", "createdAt"]
    },
    "Report": {
      "title": "Report",
      "description": "Safety report for suspicious seed advertisements or fraudulent users",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "reporterId": { "type": "string", "maxLength": 128 },
        "reporterName": { "type": "string", "maxLength": 100 },
        "targetType": { "type": "string", "enum": ["seed", "user"] },
        "targetId": { "type": "string", "maxLength": 128 },
        "targetTitle": { "type": "string", "maxLength": 150 },
        "reason": { "type": "string", "maxLength": 200 },
        "details": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["pending", "reviewed", "resolved", "dismissed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "reporterId", "targetType", "targetId", "reason", "status", "createdAt"]
    },
    "CropGuide": {
      "title": "CropGuide",
      "description": "Authentic agricultural information and crop guidance for Pakistani farmers",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "cropUrdu": { "type": "string", "maxLength": 100 },
        "cropEng": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 50 },
        "season": { "type": "string", "maxLength": 100 },
        "sowingPeriod": { "type": "string", "maxLength": 150 },
        "seedRate": { "type": "string", "maxLength": 150 },
        "irrigation": { "type": "string", "maxLength": 1000 },
        "fertilizer": { "type": "string", "maxLength": 1000 },
        "pestsAndDiseases": { "type": "string", "maxLength": 1500 },
        "harvesting": { "type": "string", "maxLength": 1000 },
        "desiVarieties": { "type": "string", "maxLength": 1000 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "cropUrdu", "cropEng", "category"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Designated administrator identifiers",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "addedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "Farmer profiles and contact preferences"
    },
    "/seeds/{seedId}": {
      "schema": { "$ref": "Seed" },
      "description": "Desi seed advertisements for exchange and direct sale"
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "Conversation" },
      "description": "Chat conversations between farmers"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "Message" },
      "description": "Text, voice recordings, and pictures sent in a conversation"
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "Report" },
      "description": "User safety reports for admin audit"
    },
    "/crop_guides/{guideId}": {
      "schema": { "$ref": "CropGuide" },
      "description": "Pakistani agricultural guides and crop management data"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "Admin" },
      "description": "Appointed administrator records"
    }
  }
}
